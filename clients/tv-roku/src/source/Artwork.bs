' Artwork URL construction -- mirrors SwarmViewModel.kt's artworkUrl and
' friends. Always gated on artwork_etag: no etag, no image (matching Fire
' TV exactly, since that's the server's own signal that no artwork exists
' for this entry/kind).
namespace Swarm.Artwork

    function Poster(baseUrl as string, entry as object, width as integer) as dynamic
        kind = "poster"
        if entry.kind = "track"
            kind = "cover"
        end if
        return url(baseUrl, entry, kind, width)
    end function

    function Backdrop(baseUrl as string, entry as object, width as integer) as dynamic
        return url(baseUrl, entry, "backdrop", width)
    end function

    ' Server serves the artist's own photo when scraped, otherwise falls
    ' back to the artist's first album cover (#277) -- no client-side
    ' fallback needed, unlike Poster()'s track->cover remap above.
    function Artist(baseUrl as string, entry as object, width as integer) as dynamic
        return url(baseUrl, entry, "artist", width)
    end function

    function FullPoster(baseUrl as string, entry as object) as dynamic
        kind = "poster"
        if entry.kind = "track"
            kind = "cover"
        end if
        return url(baseUrl, entry, kind, 0)
    end function

    function FullBackdrop(baseUrl as string, entry as object) as dynamic
        return url(baseUrl, entry, "backdrop", 0)
    end function

    function url(baseUrl as string, entry as object, kind as string, width as integer) as dynamic
        if entry.artwork_etag = invalid or entry.artwork_etag = ""
            return invalid
        end if
        path = baseUrl + "/art/" + entry.entry_key + "/" + kind + "?v=" + entry.artwork_etag
        if width > 0
            path = path + "&w=" + width.ToStr()
        end if
        return path
    end function

    ' Cache key mirrors ArtworkCacheTest.kt: identity is server + entry +
    ' kind + version + width, deliberately excluding nothing volatile here
    ' since Roku's cache key IS the request URL (no transient routing detail
    ' like a loopback proxy port ever enters it, unlike Fire TV's proxy
    ' URLs -- see platform-notes/roku.md's "Artwork" section).
    function CacheFileName(fullUrl as string) as string
        digest = CreateObject("roEVPDigest")
        digest.Setup("sha1")
        hashBytes = CreateObject("roByteArray")
        hashBytes.FromAsciiString(fullUrl)
        hashHex = digest.Process(hashBytes)
        return hashHex + ".img"
    end function

end namespace
