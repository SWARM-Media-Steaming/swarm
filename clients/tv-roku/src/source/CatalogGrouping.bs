' Client-side catalog grouping -- mirrors CatalogGrouping.kt: movies stay a
' flat list, shows/music are grouped client-side since the server has no
' "show"/"artist" entity of its own. See
' swarm-client-platform-knowledge/references/state-model.md.
namespace Swarm.CatalogGrouping

    function Movies(entries as object) as object
        movies = []
        for each e in entries
            if e.kind = "movie" and (e.extra_type = invalid or e.extra_type = "")
                movies.Push(e)
            end if
        end for
        return movies
    end function

    ' Returns [{ title, episodes: [entries...] }], insertion-ordered by
    ' first appearance, grouped case-insensitively by show_title.
    ' Groups with no preview season (only season 0 / invalid / unnumbered
    ' extras) are dropped — same rule as CatalogGrouping.previewSeasons on
    ' Fire TV, so a search that matches only those files cannot emit a show
    ' row that would read as "0 seasons".
    function Shows(entries as object) as object
        byTitle = {}
        order = []
        for each e in entries
            if e.kind = "episode" and e.show_title <> invalid
                key = LCase(e.show_title)
                if not byTitle.DoesExist(key)
                    byTitle[key] = { title: e.show_title, episodes: [] }
                    order.Push(key)
                end if
                byTitle[key].episodes.Push(e)
            end if
        end for
        result = []
        for each key in order
            group = byTitle[key]
            if HasPreviewSeason(group.episodes)
                result.Push(group)
            end if
        end for
        return result
    end function

    ' Numbered season (> 0) with a numbered episode (> 0). Season 0 is the
    ' specials/extras bucket; invalid season/episode are featurettes and
    ' other bonus files. Mirrors CatalogGrouping.kt previewSeasons.
    function IsPreviewEpisode(e as object) as boolean
        if e = invalid
            return false
        end if
        if e.season = invalid or e.season <= 0
            return false
        end if
        if e.episode = invalid or e.episode <= 0
            return false
        end if
        return true
    end function

    function HasPreviewSeason(episodes as object) as boolean
        if episodes = invalid
            return false
        end if
        for each e in episodes
            if IsPreviewEpisode(e)
                return true
            end if
        end for
        return false
    end function

    ' Seasons that qualify for a show-card / season-count label. Extra
    ' files stay on the group (Shows keeps them) but are not preview seasons.
    function PreviewSeasons(episodes as object) as object
        grouped = Seasons(episodes)
        result = []
        for each group in grouped
            if group.season <> invalid and group.season > 0
                numbered = []
                for each e in group.episodes
                    if e.episode <> invalid and e.episode > 0
                        numbered.Push(e)
                    end if
                end for
                if numbered.Count() > 0
                    result.Push({ season: group.season, episodes: numbered })
                end if
            end if
        end for
        return result
    end function

    ' Returns [{ artist, tracks: [entries...] }], insertion-ordered,
    ' grouped case-insensitively by artist (falling back to "Unknown
    ' Artist" for untagged tracks, matching the server-side classify.rs
    ' fallback convention).
    function Artists(entries as object) as object
        byArtist = {}
        order = []
        for each e in entries
            if e.kind = "track"
                artistName = e.artist
                if artistName = invalid or artistName = ""
                    artistName = "Unknown Artist"
                end if
                key = LCase(artistName)
                if not byArtist.DoesExist(key)
                    byArtist[key] = { artist: artistName, tracks: [] }
                    order.Push(key)
                end if
                byArtist[key].tracks.Push(e)
            end if
        end for
        result = []
        for each key in order
            result.Push(byArtist[key])
        end for
        return result
    end function

    ' Groups a show's episodes by season number (nulls become "Unnumbered",
    ' 0 becomes "Specials" -- the Plex/Kodi/TheTVDB bonus-content
    ' convention, matching SeasonScreen.kt).
    function Seasons(episodes as object) as object
        bySeason = {}
        order = []
        for each e in episodes
            seasonKey = "unnumbered"
            if e.season <> invalid
                seasonKey = e.season.ToStr()
            end if
            if not bySeason.DoesExist(seasonKey)
                bySeason[seasonKey] = { season: e.season, episodes: [] }
                order.Push(seasonKey)
            end if
            bySeason[seasonKey].episodes.Push(e)
        end for
        result = []
        for each key in order
            result.Push(bySeason[key])
        end for
        return result
    end function

    ' Lowest numbered (season > 0, episode > 0) pair -- used for v1's
    ' "select a show plays its first episode" simplification (full
    ' season/episode navigation is deferred, see feature-inventory.md).
    ' Season 0 is the Specials bucket (Plex/Kodi/TheTVDB); a Christmas
    ' special at 0x1 must not beat the real premiere at 1x1. Bonus content
    ' (extra_type set) is never eligible. If the group has no preview
    ' episode, fall back to the lowest remaining non-extra (specials /
    ' unnumbered) so a playable row still has a default.
    function FirstEpisode(episodes as object) as dynamic
        best = invalid
        for each e in episodes
            isExtra = e.extra_type <> invalid and e.extra_type <> ""
            if not isExtra
                if best = invalid
                    best = e
                else if IsPreviewEpisode(e) and not IsPreviewEpisode(best)
                    best = e
                else if IsPreviewEpisode(e) = IsPreviewEpisode(best)
                    eSeason = 999999
                    if e.season <> invalid
                        eSeason = e.season
                    end if
                    bestSeason = 999999
                    if best.season <> invalid
                        bestSeason = best.season
                    end if
                    if eSeason < bestSeason
                        best = e
                    else if eSeason = bestSeason
                        eEpisode = 999999
                        if e.episode <> invalid
                            eEpisode = e.episode
                        end if
                        bestEpisode = 999999
                        if best.episode <> invalid
                            bestEpisode = best.episode
                        end if
                        if eEpisode < bestEpisode
                            best = e
                        end if
                    end if
                end if
            end if
        end for
        return best
    end function

    ' Lowest track_number, unnumbered last -- same v1 simplification as
    ' FirstEpisode, for "select an artist plays their first track" (full
    ' album/track navigation is deferred).
    function FirstTrack(tracks as object) as dynamic
        best = invalid
        for each t in tracks
            if best = invalid
                best = t
            else
                tNum = 999999
                if t.track_number <> invalid
                    tNum = t.track_number
                end if
                bestNum = 999999
                if best.track_number <> invalid
                    bestNum = best.track_number
                end if
                if tNum < bestNum
                    best = t
                end if
            end if
        end for
        return best
    end function

    function SeasonLabel(season as dynamic) as string
        if season = invalid
            return "Unnumbered"
        else if season = 0
            return "Specials"
        end if
        return "Season " + season.ToStr()
    end function

end namespace
